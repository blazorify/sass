<Project>
	<Target Name="BlazorifySassNormalizeExecutablesAfterBuild" AfterTargets="CopyFilesToOutputDirectory" Condition="'$(OS)' != 'Windows_NT'">
		<ItemGroup>
			<BlazorifySassExecutable Include="$(TargetDir)runtimes/*/native/dart-sass/sass" />
			<BlazorifySassExecutable Include="$(TargetDir)runtimes/*/native/dart-sass/src/dart" />
			<BlazorifySassExecutable Include="$(TargetDir)dart" />
		</ItemGroup>

		<Exec Command="chmod 755 &quot;%(BlazorifySassExecutable.Identity)&quot;" Condition="Exists('%(BlazorifySassExecutable.Identity)')" />
	</Target>

	<Target Name="BlazorifySassNormalizeExecutablesAfterPublish" AfterTargets="CopyFilesToPublishDirectory" Condition="'$(OS)' != 'Windows_NT'">
		<ItemGroup>
			<BlazorifySassExecutable Include="$(PublishDir)runtimes/*/native/dart-sass/sass" />
			<BlazorifySassExecutable Include="$(PublishDir)runtimes/*/native/dart-sass/src/dart" />
			<BlazorifySassExecutable Include="$(PublishDir)dart" />
		</ItemGroup>

		<Exec Command="chmod 755 &quot;%(BlazorifySassExecutable.Identity)&quot;" Condition="Exists('%(BlazorifySassExecutable.Identity)')" />
	</Target>
</Project>